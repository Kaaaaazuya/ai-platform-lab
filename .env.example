# make env で .env を生成する（.env はコミットしない）
LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxx
# base64("<public>:<secret>")。OTel Collector から Langfuse への認証に使う
LANGFUSE_AUTH=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_USER_PASSWORD=

# Mac (Apple Silicon) は aarch64、CI (x86_64) は x86_64
EMULATOR_ARCH=aarch64

CHAT_MODEL=qwen2.5:7b
EMBED_MODEL=bge-m3

# ガードレール（ADR-005）。空にすると日本向けの独自ルールだけで動く
PRESIDIO_URL=http://127.0.0.1:5002
