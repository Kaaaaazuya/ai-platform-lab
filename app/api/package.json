{
  "name": "@ai-platform-lab/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --import ./src/telemetry.ts src/server.ts",
    "start": "tsx --import ./src/telemetry.ts src/server.ts",
    "ingest": "tsx --import ./src/telemetry.ts src/ingest.ts",
    "guard:check": "tsx src/guard-check.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "eval": "tsx --import ./src/telemetry.ts src/eval/run.ts",
    "eval:compare": "tsx src/eval/compare.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1169.0",
    "@aws-sdk/lib-dynamodb": "3.1169.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/auto-instrumentations-node": "0.83.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-node": "0.301.2",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.164",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
