{
  "name": "ai-platform-lab",
  "private": true,
  "description": "個人学習用 AI開発プラットフォーム（AWS Emulator＋Envoy AI Gateway＋Ollama＋OTel/Langfuse/Grafana）",
  "workspaces": [
    "app/api",
    "app/web"
  ],
  "scripts": {
    "lint": "biome check .",
    "lint:text": "textlint README.md \"docs/**/*.md\"",
    "format": "biome check --write .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "textlint": "15.8.0",
    "textlint-filter-rule-comments": "1.3.0",
    "textlint-rule-preset-ja-technical-writing": "12.0.2",
    "textlint-rule-prh": "6.1.1"
  },
  "overrides": {
    "rimraf": "6.1.4"
  }
}
