{
  "name": "ai-platform-lab",
  "private": true,
  "description": "個人学習用 AI開発プラットフォーム（AWS Emulator＋Envoy AI Gateway＋Ollama＋OTel/Langfuse/Grafana）",
  "workspaces": [
    "app/api",
    "app/web"
  ],
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8"
  },
  "overrides": {
    "rimraf": "6.1.4"
  }
}
